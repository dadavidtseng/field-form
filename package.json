{
  "name": "field-form",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "mcp",
    "app"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently --names server,expo --prefix-colors blue,green --handle-input --default-input-target expo \"npm run dev -w server\" \"npm run start -w app\"",
    "server": "npm run dev -w server",
    "test": "npm test -w shared -w server -w mcp",
    "typecheck": "npm run typecheck -w shared -w server -w mcp -w app",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mcp": "npm run start -w mcp"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1"
  }
}
